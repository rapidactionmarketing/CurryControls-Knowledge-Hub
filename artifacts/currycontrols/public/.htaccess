RewriteEngine On

# Icon and manifest types, in case the host's mime.types predates them.
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest

# Canonical host. Every page on this site declares https://www.currycontrols.com
# as its canonical URL, so the bare apex is sent to www once, permanently, with
# the path and query string intact. Two hostnames serving identical content
# splits ranking signals; this collapses them onto one.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Keep real files and directories working normally. This is the rule that
# serves the site: the build prerenders one HTML document per route as
# <route>/index.html, so a request for /calculators/voltage-drop matches a
# real directory here and Apache serves that directory's index.html.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Only routes with no prerendered file reach this line: the placeholder
# taxonomy nodes that are linked in the menus but deliberately kept out of
# the sitemap. The client router renders those.
RewriteRule ^ index.html [L]
